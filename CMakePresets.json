{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "description": "Default Ninja Debug build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GRAPHYNE_BUILD_TESTS": "ON",
        "GRAPHYNE_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "coverage",
      "inherits": "default",
      "displayName": "Coverage",
      "description": "Debug build with gcov instrumentation",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GRAPHYNE_COVERAGE": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "default",
      "displayName": "AddressSanitizer",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": { "GRAPHYNE_USE_ASAN": "ON" }
    },
    {
      "name": "lint",
      "inherits": "default",
      "displayName": "Lint",
      "binaryDir": "${sourceDir}/build/lint",
      "cacheVariables": { "GRAPHYNE_USE_CLANG_TIDY": "ON" }
    },
    {
      "name": "msvc",
      "displayName": "MSVC",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/msvc",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GRAPHYNE_BUILD_TESTS": "ON",
        "GRAPHYNE_BUILD_EXAMPLES": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default",  "configurePreset": "default",  "jobs": 0 },
    { "name": "release",  "configurePreset": "release",  "jobs": 0 },
    { "name": "coverage", "configurePreset": "coverage", "jobs": 0 },
    { "name": "asan",     "configurePreset": "asan",     "jobs": 0 },
    { "name": "lint",     "configurePreset": "lint" },
    { "name": "msvc",     "configurePreset": "msvc",     "jobs": 0 }
  ],
  "testPresets": [
    { "name": "default",  "configurePreset": "default",  "output": { "outputOnFailure": true } },
    { "name": "release",  "configurePreset": "release",  "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } }
  ]
}
